<mah:MetroWindow x:Class="WingConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:vm="clr-namespace:WingConfigurator.App.ViewModels"
        xmlns:common="clr-namespace:WingConfigurator.App.Common"
        mc:Ignorable="d"
        Title="Préconfigurateur Wing" Height="760" Width="1240"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Content="Nouveau" Command="{Binding NewEmptyProjectCommand}" />
            <Button Content="Gabarit sport" Command="{Binding LoadTemplateSportCommand}" />
            <Button Content="Ouvrir…" Command="{Binding LoadProjectCommand}" />
            <Button Content="Enregistrer…" Command="{Binding SaveProjectCommand}" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource MahApps.Brushes.Gray9}" Padding="10,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MahApps.Brushes.Text}" />
        </Border>

        <TabControl Margin="12" mah:TabControlHelper.Underlined="TabPanel">

            <!-- ===================== Langues & commentateurs ===================== -->
            <TabItem Header="LANGUES &amp; COMMENTATEURS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock DockPanel.Dock="Top" Text="Langues" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Width="140" mah:TextBoxHelper.Watermark="Nouvelle langue"
                                     Text="{Binding NewLanguageName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Ajouter" Margin="6,0,0,0" Command="{Binding AddLanguageCommand}"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Config.Languages}" DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedLanguage}" BorderThickness="1"
                                 BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" />
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,8"
                                   Text="{Binding SelectedLanguage.Name, StringFormat='Commentateurs — {0}', TargetNullValue='Sélectionne une langue à gauche'}" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+ Commentateur" Command="{Binding AddCommentatorCommand}"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                            <Button Content="Retirer la langue" Margin="8,0,0,0"
                                    Command="{Binding RemoveLanguageCommand}" CommandParameter="{Binding SelectedLanguage}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SelectedLanguage.Commentators}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="200" />
                                <DataGridComboBoxColumn Header="Retour casque + talkback" Width="260"
                                    ItemsSource="{x:Static common:EnumValues.ReturnModeOptions}"
                                    SelectedValueBinding="{Binding ReturnMode}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Retirer"
                                                    Command="{Binding DataContext.RemoveCommentatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Micros terrain ===================== -->
            <TabItem Header="MICROS TERRAIN">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ Micro" Command="{Binding AddFieldMicCommand}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Config.FieldMics}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="220" />
                            <DataGridComboBoxColumn Header="Format micro" Width="110"
                                ItemsSource="{x:Static common:EnumValues.ChannelFormats}"
                                SelectedItemBinding="{Binding Format}" />
                            <DataGridCheckBoxColumn Header="A un retour" Binding="{Binding HasReturn}" Width="80" />
                            <DataGridComboBoxColumn Header="Format retour" Width="110"
                                ItemsSource="{x:Static common:EnumValues.ChannelFormats}"
                                SelectedItemBinding="{Binding ReturnFormat}" />
                            <DataGridCheckBoxColumn Header="Talkback" Binding="{Binding TalkbackEnabled}" Width="70" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Retirer"
                                                Command="{Binding DataContext.RemoveFieldMicCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Sources PC ===================== -->
            <TabItem Header="SOURCES PC">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ Source PC" Command="{Binding AddPcSourceCommand}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Config.PcSources}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="200" />
                            <DataGridComboBoxColumn Header="Catégorie" Width="110"
                                ItemsSource="{x:Static common:EnumValues.PcSourceCategories}"
                                SelectedItemBinding="{Binding Category}" />
                            <DataGridComboBoxColumn Header="Connexion" Width="110"
                                ItemsSource="{x:Static common:EnumValues.PcConnectionTypes}"
                                SelectedItemBinding="{Binding ConnectionType}" />
                            <DataGridComboBoxColumn Header="Format" Width="100"
                                ItemsSource="{x:Static common:EnumValues.ChannelFormats}"
                                SelectedItemBinding="{Binding Format}" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Retirer"
                                                Command="{Binding DataContext.RemovePcSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Options ===================== -->
            <TabItem Header="OPTIONS">
                <StackPanel Margin="20" Width="420" HorizontalAlignment="Left">
                    <TextBlock Text="Nom de la typologie" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Config.TypologyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                    <CheckBox Content="Mix salle (bus Main dédié)" IsChecked="{Binding Config.RoomMixEnabled}" Margin="0,0,0,10" />
                    <CheckBox Content="Multipiste (enregistrement direct-out, hors capacité bus)" IsChecked="{Binding Config.RecordingMultitrackEnabled}" />
                </StackPanel>
            </TabItem>

            <!-- ===================== Récapitulatif ===================== -->
            <TabItem Header="RÉCAPITULATIF">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Recalculer" Command="{Binding RecalculateCommand}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ErrorRows}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#402D1414" BorderBrush="IndianRed" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                    <TextBlock Foreground="#FFEE9999" TextWrapping="Wrap" Text="{Binding Detail}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Text="Plan d'entrées" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding InputRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Slot" Binding="{Binding FirstSlot}" Width="50" />
                                    <DataGridTextColumn Header="Nb" Binding="{Binding SlotCount}" Width="40" />
                                    <DataGridTextColumn Header="Patch" Binding="{Binding PatchLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Plan de bus" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding BusRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding BusType}" Width="60" />
                                    <DataGridTextColumn Header="N°" Binding="{Binding BusNumber}" Width="35" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Patch physique ===================== -->
            <TabItem Header="PATCH PHYSIQUE">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource MahApps.Brushes.Gray9}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Text="Assigne chaque source à son entrée physique/réseau réelle sur la Wing. Clique sur « Recalculer » (onglet Récapitulatif) après un ajout/retrait de source pour rafraîchir cette liste." />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PatchRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PatchCard}" Width="270">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding SlotInfo}" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,0,0,10" />

                                            <TextBlock Text="Groupe de connexion" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                                            <ComboBox ItemsSource="{x:Static common:EnumValues.WingInputGroupOptions}"
                                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                                      SelectedValue="{Binding Source.PhysicalInput.Group}" Margin="0,2,0,8" />

                                            <TextBlock Text="Numéro de canal" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                                            <mah:NumericUpDown Value="{Binding Source.PhysicalInput.Index}" Minimum="1" Maximum="64" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ===================== Connexion / Export ===================== -->
            <TabItem Header="CONNEXION &amp; ENVOI">
                <StackPanel Margin="20" Width="500" HorizontalAlignment="Left">
                    <TextBlock Text="Connexion réseau à la Wing" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="IP :" VerticalAlignment="Center" Width="34" />
                        <TextBox Width="150" Text="{Binding WingHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Port :" VerticalAlignment="Center" Width="38" Margin="10,0,0,0" />
                        <TextBox Width="70" Text="{Binding WingPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,24">
                        <Button Content="Tester la connexion" Command="{Binding TestConnectionCommand}" />
                        <Button Content="Envoyer à la Wing" Margin="10,0,0,0" Command="{Binding SendToWingCommand}"
                                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    </StackPanel>

                    <TextBlock Text="Export fallback (hors réseau)" Style="{DynamicResource MahApps.Styles.TextBlock.Title}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Script OSC (.txt)" Command="{Binding ExportOscScriptCommand}" />
                        <Button Content="Fiche de patch (.csv)" Margin="10,0,0,0" Command="{Binding ExportPatchSheetCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</mah:MetroWindow>
