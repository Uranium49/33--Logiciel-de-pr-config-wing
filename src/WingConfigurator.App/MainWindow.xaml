<Window x:Class="WingConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WingConfigurator.App.ViewModels"
        xmlns:common="clr-namespace:WingConfigurator.App.Common"
        mc:Ignorable="d"
        Title="Préconfigurateur Wing" Height="720" Width="1180">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <TabControl Margin="8">

            <!-- ===================== Langues & commentateurs ===================== -->
            <TabItem Header="Langues &amp; commentateurs">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Top" Text="Langues" FontWeight="Bold" Margin="0,0,0,4" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Width="120" Text="{Binding NewLanguageName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Ajouter" Margin="4,0,0,0" Command="{Binding AddLanguageCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Config.Languages}" DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedLanguage}" />
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4"
                                   Text="{Binding SelectedLanguage.Name, StringFormat='Commentateurs — {0}', TargetNullValue='Sélectionne une langue'}" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Ajouter un commentateur" Command="{Binding AddCommentatorCommand}" />
                            <Button Content="Retirer la langue" Margin="8,0,0,0"
                                    Command="{Binding RemoveLanguageCommand}" CommandParameter="{Binding SelectedLanguage}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SelectedLanguage.Commentators}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="160" />
                                <DataGridComboBoxColumn Header="Retour casque" Width="160"
                                    ItemsSource="{x:Static common:EnumValues.ReturnModes}"
                                    SelectedItemBinding="{Binding ReturnMode}" />
                                <DataGridCheckBoxColumn Header="Talkback" Binding="{Binding TalkbackEnabled}" Width="70" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Retirer"
                                                    Command="{Binding DataContext.RemoveCommentatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Micros terrain ===================== -->
            <TabItem Header="Micros terrain">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Ajouter un micro" Command="{Binding AddFieldMicCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Config.FieldMics}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="200" />
                            <DataGridCheckBoxColumn Header="A un retour" Binding="{Binding HasReturn}" Width="80" />
                            <DataGridComboBoxColumn Header="Format retour" Width="120"
                                ItemsSource="{x:Static common:EnumValues.ChannelFormats}"
                                SelectedItemBinding="{Binding ReturnFormat}" />
                            <DataGridCheckBoxColumn Header="Talkback" Binding="{Binding TalkbackEnabled}" Width="70" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Retirer"
                                                Command="{Binding DataContext.RemoveFieldMicCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Sources PC ===================== -->
            <TabItem Header="Sources PC">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Ajouter une source PC" Command="{Binding AddPcSourceCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Config.PcSources}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="180" />
                            <DataGridComboBoxColumn Header="Catégorie" Width="110"
                                ItemsSource="{x:Static common:EnumValues.PcSourceCategories}"
                                SelectedItemBinding="{Binding Category}" />
                            <DataGridComboBoxColumn Header="Connexion" Width="110"
                                ItemsSource="{x:Static common:EnumValues.PcConnectionTypes}"
                                SelectedItemBinding="{Binding ConnectionType}" />
                            <DataGridComboBoxColumn Header="Format" Width="100"
                                ItemsSource="{x:Static common:EnumValues.ChannelFormats}"
                                SelectedItemBinding="{Binding Format}" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Retirer"
                                                Command="{Binding DataContext.RemovePcSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Options ===================== -->
            <TabItem Header="Options">
                <StackPanel Margin="16" Width="400" HorizontalAlignment="Left">
                    <TextBlock Text="Nom de la typologie" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Config.TypologyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <CheckBox Content="Mix salle (bus Main dédié)" IsChecked="{Binding Config.RoomMixEnabled}" Margin="0,0,0,8" />
                    <CheckBox Content="Multipiste (enregistrement direct-out, hors capacité bus)" IsChecked="{Binding Config.RecordingMultitrackEnabled}" />
                </StackPanel>
            </TabItem>

            <!-- ===================== Récapitulatif ===================== -->
            <TabItem Header="Récapitulatif &amp; capacité">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Recalculer" Command="{Binding RecalculateCommand}" />
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ErrorRows}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="Red" TextWrapping="Wrap"
                                           Text="{Binding Detail}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock DockPanel.Dock="Top" Text="Plan d'entrées" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding InputRows}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Slot" Binding="{Binding FirstSlot}" Width="50" />
                                    <DataGridTextColumn Header="Nb" Binding="{Binding SlotCount}" Width="40" />
                                    <DataGridTextColumn Header="Patch" Binding="{Binding PatchLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Plan de bus" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding BusRows}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding BusType}" Width="60" />
                                    <DataGridTextColumn Header="N°" Binding="{Binding BusNumber}" Width="35" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================== Connexion / Export ===================== -->
            <TabItem Header="Connexion &amp; envoi">
                <StackPanel Margin="16" Width="480" HorizontalAlignment="Left">
                    <TextBlock Text="Gabarits &amp; projet" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Nouveau (vide)" Command="{Binding NewEmptyProjectCommand}" />
                        <Button Content="Gabarit Sport multi-langues" Margin="8,0,0,0" Command="{Binding LoadTemplateSportCommand}" />
                        <Button Content="Charger un projet…" Margin="8,0,0,0" Command="{Binding LoadProjectCommand}" />
                        <Button Content="Enregistrer le projet…" Margin="8,0,0,0" Command="{Binding SaveProjectCommand}" />
                    </StackPanel>

                    <TextBlock Text="Connexion réseau à la Wing" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="IP :" VerticalAlignment="Center" Width="30" />
                        <TextBox Width="140" Text="{Binding WingHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Port :" VerticalAlignment="Center" Width="35" Margin="8,0,0,0" />
                        <TextBox Width="60" Text="{Binding WingPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                        <Button Content="Tester la connexion" Command="{Binding TestConnectionCommand}" />
                        <Button Content="Envoyer à la Wing" Margin="8,0,0,0" Command="{Binding SendToWingCommand}"
                                Background="#FFD9EAD3" />
                    </StackPanel>

                    <TextBlock Text="Export fallback (hors réseau)" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Exporter script OSC (.txt)" Command="{Binding ExportOscScriptCommand}" />
                        <Button Content="Exporter fiche de patch (.csv)" Margin="8,0,0,0" Command="{Binding ExportPatchSheetCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
